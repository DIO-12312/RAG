# Copy to a host-only .env.production file.  Do not put any secret values here.
# Production Compose builds local images from this checked-out source tree.
# A later registry workflow may override these names with immutable image refs.
RAG_IMAGE=rag-mvp-rag:production
RAG_BOOTSTRAP_IMAGE=rag-mvp-search-guard:production
ELASTICSEARCH_IMAGE=rag-mvp-elasticsearch:production
PRODUCT_API_IMAGE=rag-mvp-api:production
WEB_IMAGE=rag-mvp-web:production

# Public origin used by the Go API; P0-3 will derive this from the Caddy domain.
PRODUCT_ORIGIN=https://rag.example.com

# This directory is created and owned by the operator outside Git.
PRODUCTION_SECRETS_DIR=/etc/rag-mvp/secrets

# Named volumes are production data. Never use `down -v` on this stack.
RAG_ES_JAVA_OPTS=-Xms1g -Xmx1g
RAG_MAX_UPLOAD_BYTES=33554432
