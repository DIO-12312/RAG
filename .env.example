# Runtime
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true

# gRPC (reflection is development-only)
RAG_GRPC_HOST=0.0.0.0
RAG_GRPC_PORT=50051
RAG_GRPC_SHUTDOWN_TIMEOUT_SECONDS=10
RAG_GRPC_REFLECTION=true

# Infrastructure
RAG_MYSQL_DSN=mysql+asyncmy://rag:rag@mysql:3306/rag
RAG_MIGRATIONS_ROOT=.
RAG_ELASTICSEARCH_URL=https://elasticsearch:9200
RAG_ELASTICSEARCH_USERNAME=rag_mvp
# Direct host-side debugging reads ignored development material from these paths.
# Compose overrides both paths with the read-only client volume at /run/secrets.
# Production mounts externally managed files; never put a real password in .env.
RAG_ELASTICSEARCH_PASSWORD_FILE=data/search-guard/client/rag_mvp_password
RAG_ELASTICSEARCH_CA_CERT=data/search-guard/client/ca.pem
# Alternative for an external secret manager only; never write a real password into .env.
# RAG_ELASTICSEARCH_PASSWORD=
RAG_ELASTICSEARCH_INDEX=rag-chunks-v1
RAG_NATS_URL=nats://nats:4222
RAG_NATS_STREAM=RAG_TASKS
RAG_NATS_CONSUMER=rag-ingestion-worker
RAG_NATS_SUBJECT=rag.tasks
RAG_NATS_ACK_WAIT_SECONDS=60
RAG_NATS_MAX_DELIVER=3
RAG_OBJECT_ROOT=data/objects

# RAG execution and background loops
RAG_DEFAULT_TENANT_ID=default_tenant
RAG_MAX_UPLOAD_BYTES=16777216
RAG_PARSER_VERSION=source-router-v7
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_CHM_EXTRACTOR_PATH=extract_chmLib
RAG_CHM_EXTRACT_TIMEOUT_SECONDS=30
RAG_CHM_MAX_FILES=8192
RAG_CHM_MAX_TOPICS=4096
RAG_CHM_MAX_EXPANDED_BYTES=134217728
RAG_MAX_USER_RETRIES=3
RAG_WORKER_IDLE_INTERVAL_SECONDS=0.1
RAG_OUTBOX_POLL_INTERVAL_SECONDS=0.25
RAG_OUTBOX_BATCH_SIZE=100
RAG_MAX_FINALIZE_ATTEMPTS=5
RAG_STAGING_SWEEP_INTERVAL_SECONDS=60
RAG_STAGING_TTL_SECONDS=3600

# Legacy standalone / explicit real-model tests ONLY. Product Server/Worker ignore these.
# Configure product Embedding URL/model/key/timeout/Top-K in the web Settings page.
# Never commit a real key.
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_URL=
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_DIMENSION=
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=3
