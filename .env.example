# Runtime
RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=true

# gRPC (reflection is development-only)
RAG_GRPC_HOST=0.0.0.0
RAG_GRPC_PORT=50051
RAG_GRPC_SHUTDOWN_TIMEOUT_SECONDS=10
RAG_GRPC_REFLECTION=true

# Infrastructure
RAG_MYSQL_DSN=mysql+asyncmy://rag:rag@mysql:3306/rag
RAG_ELASTICSEARCH_URL=http://elasticsearch:9200
RAG_ELASTICSEARCH_INDEX=rag-chunks-v1
RAG_NATS_URL=nats://nats:4222
RAG_NATS_STREAM=RAG_TASKS
RAG_NATS_CONSUMER=rag-ingestion-worker
RAG_NATS_SUBJECT=rag.tasks
RAG_NATS_ACK_WAIT_SECONDS=60
RAG_NATS_MAX_DELIVER=3
RAG_OBJECT_ROOT=data/objects

# OpenAI-compatible embedding provider. Never commit a real key.
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_URL=
EMBEDDING_MODEL_NAME=
EMBEDDING_MODEL_DIMENSION=
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MAX_RETRIES=3

